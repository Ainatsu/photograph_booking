# 浏览器开发：通过 Vite 代理访问本机 FastAPI，无需处理跨域。
VITE_API_BASE_URL=/api/v1
VITE_ASSET_BASE_URL=

# Android 模拟器请改为：
# VITE_API_BASE_URL=http://10.0.2.2:8000/api/v1
# VITE_ASSET_BASE_URL=http://10.0.2.2:8000

# 真机调试请使用电脑局域网 IP，例如：
# VITE_API_BASE_URL=http://192.168.1.20:8000/api/v1
# VITE_ASSET_BASE_URL=http://192.168.1.20:8000
