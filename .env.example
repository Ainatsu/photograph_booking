APP_ENV=development

DATABASE_URL=sqlite:///./photographer.db
# Docker / production example:
# DATABASE_URL=postgresql+psycopg://photographer:photographer@postgres:5432/photographer_booking
AUTO_RUN_MIGRATIONS=true
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
PUBLIC_BASE_URL=http://localhost:8000

REDIS_URL=redis://127.0.0.1:6379/0

WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_FALLBACK_PROVIDERS=
WEB_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=10
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_CACHE_TTL_SECONDS=900
WEB_SEARCH_MAX_PAGE_BYTES=1000000
WEB_SEARCH_MAX_CONTENT_CHARS=12000
WEB_SEARCH_MAX_TOTAL_CONTENT_CHARS=50000
WEB_SEARCH_MAX_REDIRECTS=3
WEB_SEARCH_RETRIES=2
WEB_SEARCH_CIRCUIT_FAILURE_THRESHOLD=3
WEB_SEARCH_CIRCUIT_COOLDOWN_SECONDS=60

GEOCODING_PROVIDER=open_meteo
GEOCODING_API_KEY=
WEATHER_PROVIDER=open_meteo
WEATHER_API_KEY=
MAP_WEATHER_TIMEOUT_SECONDS=8
MAP_WEATHER_CACHE_TTL_SECONDS=900

AI_PROVIDER=mimo
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=mimo-v2.5
AI_REQUEST_TIMEOUT=60
AI_MAX_HISTORY_MESSAGES=20
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5
MIMO_MAX_COMPLETION_TOKENS=1024
MIMO_THINKING_MODE=disabled
MIMO_RESPONSE_FORMAT_ENABLED=false
# Temporary legacy text embedding. MiMo chat does not provide an embedding API.
# Native image search will use a separate AI_IMAGE_EMBEDDING_PROVIDER after migration.
AI_EMBEDDING_PROVIDER=mock
AI_TEXT_EMBEDDING_PROVIDER=mock
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_VERSION=v1
AI_EMBEDDING_DIMENSIONS=1536
AI_MULTIMODAL_IMAGE_WEIGHT=0.55
AI_IMAGE_SEARCH_VISUAL_WEIGHT=0.75
AI_IMAGE_SEARCH_TEXT_WEIGHT=0.10
AI_IMAGE_SEARCH_KEYWORD_WEIGHT=0.05
AI_IMAGE_SEARCH_BUSINESS_WEIGHT=0.03
AI_IMAGE_SEARCH_QUALITY_WEIGHT=0.05
AI_IMAGE_SEARCH_FRESHNESS_WEIGHT=0.02
AI_IMAGE_EMBEDDING_VERSION=v1
AI_IMAGE_EMBEDDING_BATCH_SIZE=32
AI_IMAGE_EMBEDDING_PROVIDER=disabled
# Set to local_clip after building with INSTALL_VISION_EMBEDDING=true.
AI_IMAGE_EMBEDDING_MODEL=google/siglip-base-patch16-224
AI_IMAGE_EMBEDDING_DIMENSIONS=768
AI_IMAGE_EMBEDDING_DEVICE=cpu
# Optional mirror for first-time local SigLIP download on restricted networks.
# HF_ENDPOINT=https://hf-mirror.com
AI_IMAGE_EMBEDDING_MAX_BYTES=12582912
AI_IMAGE_EMBEDDING_TIMEOUT_SECONDS=20
AI_PORTFOLIO_RRF_K=60
AI_PORTFOLIO_RRF_IMAGE_WEIGHT=1.0
AI_PORTFOLIO_RRF_TEXT_WEIGHT=1.0
AI_PORTFOLIO_RRF_CANDIDATE_MULTIPLIER=20
AI_PROMPT_VERSION=agent_prompt_v1
AI_ORCHESTRATOR_VERSION=deterministic_orchestrator_v2
AI_INDEX_VERSION=resource_index_v3
AI_PROVIDER_FALLBACK_ENABLED=true

# LLM Intent Classifier
AI_INTENT_CLASSIFIER_MODE=hybrid
AI_INTENT_CLASSIFIER_MIN_CONFIDENCE=0.72
AI_INTENT_CLASSIFIER_TIMEOUT_SECONDS=8
AI_INTENT_CLASSIFIER_JSON_MODE=true
AI_INTENT_PROMPT_VERSION=intent_classifier_v1
AGENT_ROUTING_MODE=tool_loop
AGENT_ROUTING_BASELINE_MODE=legacy
AGENT_ROUTING_ROLLOUT_PERCENT=100
AI_INDEX_WORKER_ENABLED=true
AI_INDEX_WORKER_POLL_SECONDS=10
AI_INDEX_MAX_ATTEMPTS=5
AI_CONVERSION_PRIOR_RATE=0.10
AI_CONVERSION_PRIOR_WEIGHT=10
# Legacy multi_agent rollback configuration
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-vl-plus

UPLOAD_STORAGE=local
UPLOAD_DIR=uploads

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=photographer-booking
S3_PUBLIC_BASE_URL=http://localhost:9000/photographer-booking
